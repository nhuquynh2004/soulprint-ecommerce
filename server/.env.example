# Chép file này thành .env (không commit .env) rồi điền giá trị.
# Chuỗi kết nối MongoDB Atlas: Atlas > Database > Connect > Drivers
MONGODB_URI=
MONGODB_DB=soulprint
# Tùy chọn: chỉ đặt khi gặp lỗi "querySrv ECONNREFUSED" (Node trên Windows đọc sai DNS)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Chuỗi ngẫu nhiên dài để ký cookie phiên. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Địa chỉ client Angular (CORS)
CLIENT_ORIGIN=http://localhost:4200
PORT=3000
# true: API OTP và liên kết kích hoạt trả kèm mã để hiện trên màn hình demo
DEMO_MODE=true
# Tùy chọn: true coi như luôn trong giờ hỗ trợ chat 8:00-22:00 (chỉ để thử Postman và demo buổi tối - S11)
SUPPORT_HOURS_ALWAYS=false
# Tùy chọn: khóa ký kết quả của cổng thanh toán giả lập (HMAC-SHA256). Bỏ trống thì dùng SESSION_SECRET
PAYMENT_MOCK_KEY=
# Đặt production khi deploy trên Render
NODE_ENV=development
# Tùy chọn: đăng nhập Google cho khách. Tạo OAuth Client loại "Web application" trên Google Cloud Console.
# GOOGLE_REDIRECT_URI phải khớp "Authorized redirect URIs" đã khai báo, đi qua tên miền của client để cookie phiên dùng được.
# Bỏ trống GOOGLE_CLIENT_ID thì nút "Tiếp tục với Google" báo đang tạm ngưng.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback
